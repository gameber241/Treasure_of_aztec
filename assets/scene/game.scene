    "_srcBlendFactor": 2,
    "_dstBlendFactor": 4,
    "_color": {
      "__type__": "cc.Color",
      "r": 255,
      "g": 255,
      "b": 255,
      "a": 255
    },
    "_string": "• Treasures of Aztec is a 6-reel, 5-row video slot (with an additional reel on top of reel 2, 3, 4 and 5) featuring Wilds–on–the–Way and increasing multipliers in both main game and free spins.\n\n• The game is played with 20 base bet for 2,025 ways – 32,400 ways, bet level of 1 to 10 and bet size of 0.03 to 0.90.\n\n• The Bet Size is set using the \"Bet Size\" selector.\n\n• The Bet Level is set using the \"Bet Level\" selector.\n\n• The Bet Amount is set using the \"Bet Amount\" selector.\n",
    "_horizontalAlign": 0,
    "_verticalAlign": 0,
    "_actualFontSize": 35,
    "_fontSize": 35,
    "_fontFamily": "Arial",
    "_lineHeight": 40,
    "_overflow": 3,
    "_enableWrapText": true,
    "_font": null,
    "_isSystemFontUsed": true,
    "_spacingX": 0,
    "_isItalic": false,
    "_isBold": false,
    "_isUnderline": false,
    "_underlineHeight": 2,
    "_cacheMode": 0,
    "_enableOutline": false,
