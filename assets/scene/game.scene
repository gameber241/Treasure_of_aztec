  {
    "__type__": "cc.Label",
    "_name": "",
    "_objFlags": 0,
    "__editorExtras__": {},
    "node": {
      "__id__": 467
    },
    "_enabled": true,
    "__prefab": null,
    "_customMaterial": null,
    "_srcBlendFactor": 2,
    "_dstBlendFactor": 4,
    "_color": {
      "__type__": "cc.Color",
      "r": 255,
      "g": 255,
      "b": 255,
      "a": 255
    },
    "_string": "• \"Cash Wallet\" displays the cash available for wagering.\n\n• \"Auto Spin\" automatically plays the game for a selected number of rounds.\n\n• Winning combinations and payouts are made according to the \"Paytable\".\n\n• A bet way win in cash is equal to the value shown in the \"Paytable\" multiplied by the bet size and bet level.\n\n• Bet ways win if the winning symbols are in succession from the leftmost reel to the right.\n\n• The total number of winning bet ways for each symbol is calculated by multiplying the number of adjacent winning symbols on each reel from the leftmost reel to the right.\n\n• The winning symbol payout is multiplied by the number of winning bet ways.\n\n• Simultaneous wins on different bet ways are added together.\n\n• After the payout of every round is made, all winning symbols will explode, allowing the symbols above them to cascade down for a new round.\n\n• Additional winning combinations will be tallied in every round until no more winning combinations can be tallied.\n\n• All wins are shown in cash.\n",
    "_horizontalAlign": 0,
    "_verticalAlign": 0,
    "_actualFontSize": 35,
    "_fontSize": 35,
    "_fontFamily": "Arial",
    "_lineHeight": 40,
    "_overflow": 3,
    "_enableWrapText": true,
    "_font": null,
    "_isSystemFontUsed": true,
    "_spacingX": 0,
    "_isItalic": false,
